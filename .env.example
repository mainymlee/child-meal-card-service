# 브라우저에 노출되는 카카오맵 JS SDK 키. 지도가 뜨려면 반드시 필요.
# Vercel Production/Preview 환경변수에도 동일하게 등록해야 함.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# scripts/geocode-stores.mjs (npm run geocode) 전용 — 로컬에서만 사용, Vercel에는 등록하지 않음.
KAKAO_REST_API_KEY=

# 한끼 AI 메뉴 추천 전용 서버 키. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# Vercel Production/Preview 환경변수에도 등록해야 합니다.
OPENAI_API_KEY=

# 선택 사항. 비워두면 gpt-5-mini를 사용합니다.
OPENAI_RECOMMEND_MODEL=gpt-5-mini
